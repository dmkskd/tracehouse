# Canonical images used by repository-managed development and test commands.
#
# Override either value for one command without editing this file:
#
#   CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:23.8.16.40-alpine just test-clickhouse
#   CLICKHOUSE_IMAGE=altinity/clickhouse-server:26.3.16.10001.altinitystable just test-clickhouse
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:26.8.2
CLICKHOUSE_KEEPER_IMAGE=clickhouse/clickhouse-keeper:26.8.2
