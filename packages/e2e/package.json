{
  "name": "@tracehouse/e2e",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test:setup": "bash ./playwright.sh install chromium",
    "pretest": "npm run test:setup",
    "test": "bash ./playwright.sh test",
    "test:grafana": "bash ./playwright.sh test --config playwright.grafana.config.ts",
    "test:timezone": "bash ./playwright.sh test --config playwright.timezone.config.ts",
    "test:timezone-transports": "bash ./playwright.sh test --config playwright.timezone-transports.config.ts",
    "test:ui": "bash ./playwright.sh test --ui",
    "test:headed": "SLOWMO=500 bash ./playwright.sh test --headed",
    "test:report": "bash ./playwright.sh show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2"
  }
}
